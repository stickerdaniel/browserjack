{
  "name": "browserjack",
  "version": "0.3.0",
  "description": "A local macOS MCP bridge that lets Claude Code and other MCP clients reuse OpenAI's installed Codex browser runtime.",
  "keywords": [
    "browser-automation",
    "browser-bridge",
    "chatgpt",
    "chrome",
    "chromium",
    "claude-code",
    "codex",
    "computer-use",
    "helium",
    "macos",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "node-repl",
    "openai"
  ],
  "homepage": "https://github.com/stickerdaniel/browserjack#readme",
  "bugs": {
    "url": "https://github.com/stickerdaniel/browserjack/issues"
  },
  "license": "MIT",
  "author": "Daniel Sticker (https://github.com/stickerdaniel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stickerdaniel/browserjack.git"
  },
  "bin": {
    "browserjack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "compatibility",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "npm run build && node --test test/*.test.mjs",
    "doctor": "npm run build --silent && node dist/cli.js doctor",
    "prepack": "npm run build",
    "pack:check": "sh scripts/pack-check.sh",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm run verify:versions && npm test"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
