{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "schedule:weekly"
  ],
  "rangeStrategy": "pin",
  "npmrc": "force=true",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Merge non-major updates once all checks pass; the package has no runtime dependencies",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Actions in the release workflow run with the npm publishing identity; review them by hand",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/release.yml"],
      "automerge": false
    },
    {
      "description": "Keep the supported Node engine range as a project compatibility decision",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "description": "Group the VoidZero toolchain (oxlint, oxfmt, tsgolint move quickly)",
      "groupName": "oxc toolchain",
      "matchPackageNames": ["oxlint", "oxfmt", "oxlint-tsgolint"]
    },
    {
      "description": "TypeScript pins the tsgolint compatibility target; update it separately",
      "matchPackageNames": ["typescript"],
      "groupName": "typescript"
    }
  ]
}
